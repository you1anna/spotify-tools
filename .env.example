# Copy this file to .env and fill in your own values.
# Create a free app at https://developer.spotify.com/dashboard to get these.
# In the app settings, add this exact Redirect URI: http://127.0.0.1:8888/callback
# (Spotify requires a loopback IP, not "localhost", for the redirect URI.)

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
